<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_music_manager_track" model="ir.actions.act_window">
            <field name="name">Tracks</field>
            <field name="res_model">music_manager.track</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('custom_owner_id', '=', uid)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tracks found. To add a new one, press on 'Add Track' button!
                </p>
                <p>
                    You only see your own tracks.
                </p>
            </field>
        </record>
    </data>
</odoo>