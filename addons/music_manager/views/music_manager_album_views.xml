<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_music_manager_album" model="ir.actions.act_window">
            <field name="name">Albums</field>
            <field name="res_model">music_manager.album</field>
            <field name="view_mode">kanban,form</field>
            <field name="domain">[('custom_owner_ids', 'in', [uid])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No albums found. Let's create new one!
                </p>
                <p>
                    You only see your own or shared albums.
                </p>
            </field>
        </record>
    </data>
</odoo>